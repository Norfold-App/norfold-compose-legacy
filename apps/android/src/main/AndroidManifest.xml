<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Task reminders. SCHEDULE_EXACT_ALARM rather than USE_EXACT_ALARM: the latter is granted
         automatically but Play policy reserves it for alarm-clock and calendar apps, which Norfold
         is not. This one the user grants, so the scheduler checks canScheduleExactAlarms() and
         falls back to a delivery window rather than assuming it and throwing SecurityException. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- AlarmManager keeps nothing across a restart, so without this one reboot silently disarms
         every future reminder. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Chat voice messages; requested at first tap of the mic button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:label="Norfold"
        android:name=".NorfoldApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Norfold.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The calendar OAuth return. supabase/functions/calendar-callback redirects here with
                 ?status=connected or ?status=error once a provider grants offline access, having
                 stored the encrypted refresh token first. MainActivity hands the intent to
                 DocsViewModel.handleCalendarReturn, which reads neither the status nor anything else
                 in the URI: a deep link is a string any app on the device can send, so the only
                 trustworthy answer comes from re-reading integration_accounts through RLS. The URI
                 is therefore a prompt to go and look, not a statement of what happened. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="norfold" android:host="integrations" android:path="/calendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="norfold" android:host="verify" android:path="/telegram" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name=".cloud.NorfoldMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Crash reporting starts OFF and stays off until the user turns diagnostics on.

             This flag is the only thing standing between a first launch and a report, and it has to be
             here rather than only in code. Crashlytics installs its uncaught-exception handler from a
             ContentProvider that the manifest merger injects, which runs before Application.onCreate —
             so a crash during startup on a first launch would be collected and uploaded before any
             Kotlin of ours had the chance to say no. Setting this to false makes the SDK read its
             enabled state from persisted storage instead of defaulting to on, and NorfoldApplication
             writes that storage from the DiagnosticsStore preference on every start.

             The value is not a suggestion to the SDK; it is what `isCrashlyticsCollectionEnabled`
             returns until something calls the setter. Do not "tidy" it to true to make testing easier —
             this app declares allowBackup="false" and excludes everything from both backup rule sets,
             and shipping opt-out crash upload would contradict that posture on the user's behalf. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <receiver
            android:name=".cloud.NorfoldNotificationActionReceiver"
            android:exported="false" />
        <!-- Task reminders. Not exported: only AlarmManager and the system broadcasts below reach
             it, and nothing another app sends should be able to make Norfold post a reminder.
             android:directBootAware is deliberately absent — the reminder rows live in the
             credential-encrypted database, so there is nothing to read before first unlock. -->
        <receiver
            android:name=".data.TaskReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.norfold.app.action.DELIVER_TASK_REMINDERS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
